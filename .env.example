# =============================================================================
# Eternal Longevity — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local`. In production, set the same keys in the Vercel dashboard
# (Project -> Settings -> Environment Variables).
#
# The app runs as a fully working localStorage-backed DEMO with none of these
# set. Each service switches on the moment its keys are present.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Used by sitemap, robots, OG image, and absolute-URL generation.
NEXT_PUBLIC_SITE_URL=https://eternal-longevity-seven.vercel.app


# -----------------------------------------------------------------------------
# Supabase  — database + auth + storage
# -----------------------------------------------------------------------------
# From the Supabase dashboard -> Project Settings -> API.
# URL + anon key are public (safe in the browser). The service-role key is
# SERVER-ONLY — it bypasses Row-Level Security. Never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Frame  — card payments (saved cards, charges, refunds)
# -----------------------------------------------------------------------------
# From the Frame dashboard (app.framepayments.com). SERVER-ONLY secret.
# The prefix picks the environment (same API URL): sk_sandbox_... for testing,
# sk_production_... for live. Never mix sandbox and live keys.
FRAME_SECRET_KEY=
# Publishable key (pk_...), prefixed NEXT_PUBLIC_ because Frame.js needs it in
# the browser. Use the one that matches the secret key's environment.
NEXT_PUBLIC_FRAME_PUBLISHABLE_KEY=
# Signs the X-Frame-Signature header on webhooks. Shown ONCE when you create
# (or rotate) the endpoint for /api/webhooks/frame — save it then.
FRAME_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Resend  — transactional email
# -----------------------------------------------------------------------------
# From resend.com -> API Keys. Used for: intake confirmation, physician
# sign-off, shipment updates. Sign a BAA with Resend before sending PHI.
RESEND_API_KEY=
# Verified sender. Format: "Display Name <address@yourdomain.com>".
RESEND_FROM_EMAIL=Eternal Longevity <hello@eternallongevity.com>
# Inbox that receives "new intake to review" notifications.
CARE_TEAM_EMAIL=
# Inbox at the compounding pharmacy that receives "new order" notifications.
PHARMACY_EMAIL=


# -----------------------------------------------------------------------------
# Pharmacy partner API (RXHere)  — optional
# -----------------------------------------------------------------------------
# RxHere practice ordering API (Integration Guide, Oct 2026). Both server-only.
# RXHERE_API_TOKEN: the practice API key. vr_test_… is the sandbox: every check
#   runs, nothing is created, shipped or charged. Swap in the live key to go live.
# RXHERE_WEBHOOK_SECRET: the signing secret RxHere shows once when it registers
#   our webhook address: https://www.etlongevity.com/api/webhooks/rxhere
# Without both, every order is placed by hand from the orders board.
RXHERE_API_TOKEN=
RXHERE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Twilio  — SMS  (optional)
# -----------------------------------------------------------------------------
# From console.twilio.com. Used for delivery alerts and 2FA codes. A Twilio BAA
# is required only if SMS will contain health information.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# Sentry — error monitoring  (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# Analytics  (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
